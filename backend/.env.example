# AI工具合集 后端配置样例 —— 复制为 .env 后按实际环境填写
# 启动时会校验必填项，缺失将 fail fast 报错退出

APP_NAME=AI工具合集
PORT=8080

# 达梦数据库
DM_HOST=192.168.0.32
DM_PORT=5236
DM_USER=
DM_PASSWORD=
DM_SCHEMA=DETECTION
DM_POOL_MIN=1
DM_POOL_MAX=6

# SQL Server
SQL_SERVER=192.168.0.30
SQL_PORT=1433
SQL_DATABASE=Elims
SQL_USER=
SQL_PASSWORD=
SQL_ODBC_DRIVER=SQL Server
SQL_TIMEOUT=30

# 查询超时（秒）
QUERY_TIMEOUT=60

# 一单一库核对（CMA 平台）
CMA_BASE=https://cma.caqit.org.cn/cma-admin/system/standardData/list
CMA_TIMEOUT=20
CMA_RETRY=3
CMA_RETRY_INTERVAL=1
CMA_CONCURRENCY=5

# 核对台账（留痕）：每次核对写入批次+明细，供资质认定"能力持续符合/体系持续有效运行"取证
# 目录留空时默认 <backend>/data/cma_ledger；如需长期归档到其他盘（如 F:\取证台账）在此指定
CMA_LEDGER_ENABLED=true
CMA_LEDGER_DIR=

# 抽采样进度统计（/progress）：产品类型/合同/任务量/完成量快照落本地 SQLite
# 目录留空时默认 <backend>/data/progress
PROGRESS_DIR=
# 完成量每天定时重算时刻（HH:MM）。必须晚于镜像同步时刻（MIRROR_SYNC_AT）；留空=只允许手动同步
PROGRESS_SYNC_AT=19:40

# 数据来源模式：mirror=走 SQLite 镜像（默认）/ direct=源库直连
DATA_MODE=mirror
# SQLite 镜像目录（C 盘紧张时指向其他盘，如 F:/aitools-mirror）
MIRROR_DIR=
MIRROR_KEEP=10
MIRROR_BATCH=10000
# 每次同步重搬的来源：dm=只搬达梦；dm,sqlserver=全量
MIRROR_SYNC_SOURCES=dm
# 镜像每天定时同步时刻（HH:MM）
MIRROR_SYNC_AT=19:00
